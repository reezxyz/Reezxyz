<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 520" width="1200" height="520" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <clipPath id="r"><rect width="1200" height="520" rx="28"/></clipPath>
  </defs>
  <g clip-path="url(#r)">
    <rect width="1200" height="520" fill="#0B0B12"/>
    <!-- blobs -->
    <path d="M0 0 H320 C350 40 280 85 235 72 C185 58 165 125 95 112 C45 102 0 95 0 95 Z" fill="#6D3CF0"/>
    <path d="M0 395 C60 372 135 405 155 458 C165 505 115 520 0 520 Z" fill="#2F7BFF"/>
    <path d="M1200 140 C1140 150 1115 215 1135 280 C1150 335 1200 350 1200 350 Z" fill="#FF5A36"/>
    <circle cx="1090" cy="120" r="3" fill="#FF5A36"/>

    <!-- greeting -->
    <text x="92" y="122" font-family="'Segoe Print','Comic Sans MS',cursive" font-size="30" font-style="italic" fill="#fff">Hey,</text>
    <path d="M150 128 q22 8 18 36 m0 0 l-9 -10 m9 10 l10 -8" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <text x="150" y="205" font-family="'Trebuchet MS',Verdana,sans-serif" font-size="64" font-weight="900" fill="#fff">I'm</text>
    <path d="M300 112 l12 -26 l14 20 l14 -20 l12 26 z" fill="none" stroke="#C6F432" stroke-width="4" stroke-linejoin="round"/>

    <!-- name -->
    <text x="82" y="318" textLength="640" lengthAdjust="spacingAndGlyphs" font-family="'Arial Black','Trebuchet MS',Impact,sans-serif" font-size="118" font-weight="900" fill="#fff" transform="rotate(-2 82 318)">YOUR NAME</text>
    <path d="M90 346 Q400 322 720 334 L716 352 Q400 342 94 366 Z" fill="#C6F432"/>

    <!-- subtitle -->
    <text x="92" y="410" font-family="'Trebuchet MS',Verdana,sans-serif" font-size="26" fill="#fff">Developer <tspan fill="#C6F432">●</tspan> Designer <tspan fill="#C6F432">●</tspan> Creator</text>

    <!-- buttons -->
    <rect x="92" y="438" width="226" height="56" rx="28" fill="#C6F432"/>
    <polygon points="126,454 126,478 146,466" fill="#0B0B12"/>
    <text x="160" y="473" font-family="'Trebuchet MS',Verdana,sans-serif" font-size="20" font-weight="700" fill="#0B0B12">View Projects</text>
    <rect x="338" y="438" width="190" height="56" rx="28" fill="none" stroke="#6D3CF0" stroke-width="3"/>
    <text x="372" y="473" font-family="'Trebuchet MS',Verdana,sans-serif" font-size="20" fill="#fff">Contact Me ↗</text>

    <!-- speech bubble -->
    <g transform="rotate(-10 740 110)">
      <rect x="640" y="62" width="200" height="86" rx="26" fill="#4DA3FF"/>
      <polygon points="800,140 850,182 782,148" fill="#4DA3FF"/>
      <text x="740" y="94" text-anchor="middle" font-family="'Trebuchet MS',sans-serif" font-size="17" font-weight="800" fill="#0B0B12">LET'S CREATE</text>
      <text x="740" y="116" text-anchor="middle" font-family="'Trebuchet MS',sans-serif" font-size="17" font-weight="800" fill="#0B0B12">SOMETHING</text>
      <text x="740" y="138" text-anchor="middle" font-family="'Trebuchet MS',sans-serif" font-size="17" font-weight="800" fill="#0B0B12">AWESOME!</text>
    </g>

    <!-- doodles -->
    <path d="M1135 62 l9 22 l24 2 l-18 16 l6 24 l-21 -13 l-21 13 l6 -24 l-18 -16 l24 -2 z" fill="#C6F432" transform="scale(.7) translate(480 20)"/>
    <path d="M1060 40 q20 -22 36 0 t36 0" stroke="#4DA3FF" stroke-width="4" fill="none" stroke-linecap="round"/>
    <path d="M585 430 l-22 44 h20 l-10 38 l36 -52 h-22 l14 -30 z" fill="#C6F432"/>
    <circle cx="640" cy="470" r="22" fill="none" stroke="#C6F432" stroke-width="4"/>
    <circle cx="632" cy="464" r="3" fill="#C6F432"/><circle cx="648" cy="464" r="3" fill="#C6F432"/>
    <path d="M630 475 q10 10 20 0" stroke="#C6F432" stroke-width="3" fill="none" stroke-linecap="round"/>
    <path d="M740 395 q15 -12 30 0 t30 0" stroke="#6D3CF0" stroke-width="4" fill="none" stroke-linecap="round"/>

    <!-- character -->
    <!-- hoodie body -->
    <path d="M790 520 C800 410 860 360 940 352 C1030 358 1105 410 1125 520 Z" fill="#6D3CF0"/>
    <path d="M880 372 C910 395 970 395 1000 372 C985 360 895 360 880 372 Z" fill="#5428D6"/>
    <path d="M925 385 v55 M955 385 v55" stroke="#C6F432" stroke-width="3" stroke-linecap="round"/>
    <!-- raised arm -->
    <line x1="855" y1="420" x2="805" y2="335" stroke="#6D3CF0" stroke-width="46" stroke-linecap="round"/>
    <ellipse cx="796" cy="305" rx="27" ry="31" fill="#FFC9A0"/>
    <g stroke="#FFC9A0" stroke-width="13" stroke-linecap="round">
      <line x1="778" y1="284" x2="767" y2="242"/><line x1="792" y1="276" x2="788" y2="228"/>
      <line x1="808" y1="277" x2="812" y2="230"/><line x1="822" y1="290" x2="835" y2="250"/>
      <line x1="772" y1="312" x2="742" y2="296"/>
    </g>
    <!-- head -->
    <circle cx="858" cy="262" r="15" fill="#F0B186"/>
    <circle cx="858" cy="262" r="5" fill="#C6F432"/>
    <circle cx="940" cy="255" r="86" fill="#FFC9A0"/>
    <!-- hair -->
    <g fill="#05050A" stroke="#3B3470" stroke-width="3">
      <circle cx="872" cy="198" r="36"/><circle cx="912" cy="168" r="40"/><circle cx="962" cy="160" r="42"/>
      <circle cx="1006" cy="184" r="38"/><circle cx="1022" cy="232" r="26"/><circle cx="858" cy="240" r="24"/>
    </g>
    <path d="M866 218 Q940 200 1018 222 Q1000 180 940 178 Q880 180 866 218 Z" fill="#05050A"/>
    <!-- face -->
    <path d="M900 245 q15 -14 30 0" stroke="#1A1020" stroke-width="6" fill="none" stroke-linecap="round"/>
    <circle cx="978" cy="248" r="16" fill="#fff"/><circle cx="982" cy="249" r="9" fill="#1A1020"/>
    <path d="M958 222 q20 -10 40 0" stroke="#1A1020" stroke-width="5" fill="none" stroke-linecap="round"/>
    <path d="M900 284 Q945 345 995 282 Z" fill="#3A0F1A"/>
    <path d="M905 286 Q945 296 992 285 L990 281 Q945 292 903 282 Z" fill="#fff"/>
    <ellipse cx="948" cy="312" rx="18" ry="9" fill="#FF6B8A"/>
    <circle cx="893" cy="275" r="9" fill="#FF9A8A" opacity=".6"/>
    <!-- clapperboard + lanyard -->
    <path d="M915 372 Q960 440 1060 420" stroke="#C6F432" stroke-width="3" fill="none"/>
    <g transform="rotate(-18 1085 440)">
      <rect x="1030" y="425" width="120" height="78" rx="6" fill="#14121C" stroke="#fff" stroke-width="3"/>
      <rect x="1030" y="400" width="120" height="24" rx="4" fill="#fff"/>
      <g fill="#14121C"><polygon points="1042,400 1058,400 1046,424 1030,424"/><polygon points="1076,400 1092,400 1080,424 1064,424"/><polygon points="1110,400 1126,400 1114,424 1098,424"/></g>
      <polygon points="1075,445 1075,480 1105,462" fill="#fff"/>
    </g>
    <path d="M1000 90 l-10 28 M1030 70 l-4 24" stroke="#FF5A36" stroke-width="3" stroke-linecap="round"/>
  </g>
</svg>
